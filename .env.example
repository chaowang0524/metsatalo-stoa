# Copy this file to .env and fill in the values locally.
# DeepSeek routing and Kimi use the same Verda Inference base URL.
VERDA_INFERENCE_BASE_URL=
VERDA_INFERENCE_API_KEY=
VERDA_KIMI=

# hybrid requires both DeepSeek and Kimi keys.
# Use deepseek if only VERDA_INFERENCE_API_KEY is available.
STOA_ROUTER=hybrid

# Optional dedicated Nemotron endpoint; not used by hybrid.
# NEMOTRON_API_KEY=
# NEMOTRON_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
